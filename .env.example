# ==========================================
# FixMate Client Application Environment Variables
# ==========================================

# Better Auth Secret (Generate via: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# App Base URL (Next.js client)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# FixMate Express API Backend Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fixmate-service?retryWrites=true&w=majority

# Stripe Payment Gateway Credentials
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key

# ImgBB Image Upload API Key (for user avatars & service thumbnails)
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

# Google OAuth Social Login (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
